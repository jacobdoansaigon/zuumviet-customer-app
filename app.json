{
  "expo": {
    "name": "ZUUMCUSTOMER",
    "slug": "zv-customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "zuumcustomer",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.zuumviet.customer"
    },
    "android": {
      "package": "vn.zuumviet.customer",
      "adaptiveIcon": {
        "backgroundColor": "#6B35D4",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ứng dụng cần vị trí để hiển thị bản đồ và giao hàng.",
          "locationAlwaysPermission": "Ứng dụng cần vị trí nền để tài xế có thể nhận đơn.",
          "locationWhenInUsePermission": "Ứng dụng cần vị trí để điều hướng giao hàng.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6B35D4",
          "sounds": [
            "./assets/notification.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập ảnh để tải lên giấy tờ tài xế.",
          "cameraPermission": "Ứng dụng cần camera để chụp giấy tờ tài xế."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần camera để quét mã QR của tài xế."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f1974ba-2473-48e9-b3a1-717d273b9847"
      }
    },
    "owner": "acbook"
  }
}
